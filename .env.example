# Non-secret config lives in ./config/server.yaml (server, postgres and redis sections).
# These env vars override YAML values — set them for secrets and per-environment overrides.

# Required:
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Used by `make migrate-up`. The application itself reads Postgres/Redis
# connection settings from config/server.yaml (host/port/username/...).
DATABASE_URL=postgres://bgex:bgex@localhost:5432/bgex?sslmode=disable

# Optional server overrides (defaults come from config/server.yaml):
#APP_ENV=development
#APP_PORT=8080
#JWT_ACCESS_TTL=15m
#REFRESH_TOKEN_TTL=720h
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional — set all three to enable Google OAuth routes:
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
